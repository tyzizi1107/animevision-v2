{
  "name": "animevision",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "catalogue:tmdb": "node --env-file=.env.local scripts/import-tmdb-anime.mjs",
    "catalogue:franime": "node --env-file=.env.local scripts/sync-franime.mjs",
    "catalogue:franime:metadata": "node --env-file=.env.local scripts/sync-franime.mjs --metadata-only",
    "catalogue:franime:refresh": "node --env-file=.env.local scripts/enrich-franime.mjs --refresh-matched-only",
    "calendar:sync": "node --env-file=.env.local scripts/sync-calendar.mjs",
    "catalogue:anime-sama": "node --env-file=.env.local scripts/sync-anime-sama.mjs",
    "sync-catalogue": "node scripts/sync-catalogue.mjs",
    "veille": "node scripts/veille.mjs",
    "veille:boucle": "node scripts/veille.mjs --minutes=10",
    "catalogue:anime-sama:tmdb": "node --env-file=.env.local scripts/enrich-anime-sama.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "mongodb": "^7.4.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.0"
  }
}
